{
  "name": "elevenlabs-discord-voicebot",
  "description": "Simple demo of ElevenLabs Conversational AI WebSocket that enables Discord users to talk to LLMs via voice.",
  "main": "dist/api/discord/client.js",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "setup": "node scripts/setup.mjs",
    "start": "npm run build && node dist/api/discord/client.js",
    "test": "npm run build && node --test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  }
}
