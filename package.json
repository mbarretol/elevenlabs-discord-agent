{
  "name": "elevenlabs-discord-voicebot",
  "description": "Simple demo of ElevenLabs Conversational AI WebSocket that enables Discord users to talk to LLMs via voice.",
  "main": "dist/api/discord/client.js",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --project tsconfig.json",
    "start": "npm run build && node dist/api/discord/client.js",
    "test": "npm run build && node --test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.16.3",
    "dotenv": "^17.2.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^24.0.14",
    "eslint": "^9.11.1",
    "globals": "^16.3.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0"
  }
}
